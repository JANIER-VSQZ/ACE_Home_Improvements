<div class="proyecto-card">
  <div class="imagen-container">
    <img src="{{imgLink}}" alt="{{titulo}}" data-i18n="[alt]proyectos.items.{{indice}}.titulo" />
  </div>
  <div class="contenido">
    <h3 data-i18n="proyectos.items.{{indice}}.titulo">{{titulo}}</h3>
    <p data-i18n="proyectos.items.{{indice}}.descripcion">{{descripcion}}</p>
  </div>
</div>
