<form class="job-card__form" id="jobForm" method="post" data-demo-form novalidate>
    <h2 data-i18n="empleos.formulario">Solicitud de empleo</h2>
    {{>avisoDemo}}
    <div class="form-group">
        <label for="puesto" data-i18n="empleos.puesto">Puesto al que deseas aplicar:</label>
        <select id="puesto" name="puesto" required>
            <option value="" data-i18n="empleos.seleccionar">Selecciona un puesto</option>
            {{#each mesas}}
                <option value="{{@index}}" data-i18n="empleos.items.{{@index}}.plaza">{{plaza}}</option>
            {{/each}}
        </select>
    </div>
    <div class="form-row">
        <div class="form-group">
            <label for="name" data-i18n="empleos.nombre">Nombre:</label>
            <input type="text" id="name" name="nombre" autocomplete="name" required>
        </div>
        <div class="form-group">
            <label for="email" data-i18n="empleos.email">Email:</label>
            <input type="email" id="email" name="email" autocomplete="email" required>
        </div>
    </div>
    <div class="form-group">
        <label for="phone" data-i18n="empleos.telefono">Teléfono:</label>
        <input type="tel" id="phone" name="telefono" autocomplete="tel" required>
    </div>
    <button type="submit" class="apply-btn" data-i18n="empleos.aplicar">Probar solicitud</button>
</form>
