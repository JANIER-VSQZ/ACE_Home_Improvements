<section class="job-card">
    <h2 data-i18n="empleos.items.{{indice}}.plaza">{{plaza}}</h2>
    <p><strong data-i18n="empleos.ubicacion">Ubicación:</strong> {{ciudad}}</p>
    <p><strong data-i18n="empleos.tipo">Tipo:</strong> <span data-i18n="empleos.items.{{indice}}.tipoContrato">{{tipoContrato}}</span></p>
    <p><strong data-i18n="empleos.descripcion">Descripción:</strong> <span data-i18n="empleos.items.{{indice}}.descripcionPuesto">{{descripcionPuesto}}</span></p>
    <a href="#" class="apply-btn" data-i18n="empleos.aplicar">Aplicar ahora</a>
</section>
