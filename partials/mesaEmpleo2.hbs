<div data-job-details="{{indice}}" hidden>
    <h3 data-i18n="empleos.items.{{indice}}.plaza">{{plaza}}</h3>
    <p><strong data-i18n="empleos.ubicacion">Ubicación:</strong> {{ciudad}}</p>
    <p><strong data-i18n="empleos.tipoContrato">Tipo de contrato:</strong> <span data-i18n="empleos.items.{{indice}}.tipoContrato">{{tipoContrato}}</span></p>
    <p><strong data-i18n="empleos.descripcionPuesto">Descripción del puesto:</strong></p>
    <p data-i18n="empleos.items.{{indice}}.descripcionPuesto">{{descripcionPuesto}}</p>
</div>
