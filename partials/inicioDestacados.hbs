<section class="inicio-proyectos" aria-labelledby="inicio-proyectos-titulo">
    <div class="inicio-encabezado">
        <div>
            <p class="inicio-etiqueta" data-i18n="inicio.portafolio">Nuestro trabajo</p>
            <h2 id="inicio-proyectos-titulo" data-i18n="proyectos.titulo">Proyectos destacados</h2>
            <p data-i18n="inicio.proyectosDescripcion">Conoce los materiales, acabados y detalles de nuestros proyectos.</p>
        </div>
        <a class="inicio-enlace" href="galeria.html" data-i18n="inicio.verGaleria">Explorar la galería</a>
    </div>
    <div class="inicio-proyectos-grid">
        {{#each proyectosInicio}}
        <article class="inicio-proyecto">
            <img src="{{imgLink}}" alt="{{titulo}}" loading="lazy" width="640" height="420" data-i18n="[alt]proyectos.items.{{@index}}.titulo">
            <div>
                <h3 data-i18n="proyectos.items.{{@index}}.titulo">{{titulo}}</h3>
                <p data-i18n="inicio.resumenProyectos.{{@index}}"></p>
                <a href="proyectosDestacados.html#proyecto-{{@index}}" data-i18n="inicio.verProyecto">Ver el proyecto</a>
            </div>
        </article>
        {{/each}}
    </div>
</section>

<section class="inicio-proceso" aria-labelledby="inicio-proceso-titulo">
    <p class="inicio-etiqueta" data-i18n="inicio.acompanamiento">De la idea a la obra</p>
    <h2 id="inicio-proceso-titulo" data-i18n="inicio.procesoTitulo">Cómo trabajamos</h2>
    <div class="inicio-proceso-grid">
        <article><span aria-hidden="true">01</span><h3 data-i18n="inicio.proceso.0.titulo">Cuéntanos tu proyecto</h3><p data-i18n="inicio.proceso.0.descripcion">Comparte lo que necesitas y la ubicación del trabajo para consultar disponibilidad.</p></article>
        <article><span aria-hidden="true">02</span><h3 data-i18n="inicio.proceso.1.titulo">Planificamos los detalles</h3><p data-i18n="inicio.proceso.1.descripcion">Coordinamos permisos, materiales y personal según las necesidades del proyecto.</p></article>
        <article><span aria-hidden="true">03</span><h3 data-i18n="inicio.proceso.2.titulo">Supervisamos el trabajo</h3><p data-i18n="inicio.proceso.2.descripcion">Damos seguimiento a la ejecución y mantenemos la comunicación durante el proceso.</p></article>
    </div>
    <a class="inicio-enlace" href="acercaNosotros.html" data-i18n="inicio.conocerEquipo">Conoce nuestra empresa</a>
</section>

<section class="testimonios inicio-testimonios" aria-labelledby="inicio-testimonios-titulo">
    <h2 id="inicio-testimonios-titulo" data-i18n="testimonios.titulo">Testimonios de nuestros clientes</h2>
    <div class="testimonios-grid">
        {{#each testimoniosInicio}}
            {{>testimoniosclientes}}
        {{/each}}
    </div>
    <a class="inicio-enlace" href="testimonios.html" data-i18n="inicio.verTestimonios">Ver todos los testimonios</a>
</section>

<section class="inicio-contacto" aria-labelledby="inicio-contacto-titulo">
    <div>
        <p class="inicio-etiqueta" data-i18n="inicio.coberturaTitulo">Nuestra cobertura</p>
        <h2 id="inicio-contacto-titulo" data-i18n="inicio.contactoTitulo">Hablemos de tu próximo proyecto</h2>
        <p data-i18n="inicio.coberturaDescripcion">Trabajamos en Estados Unidos. Consulta disponibilidad para tu ubicación y el servicio que necesitas.</p>
    </div>
    <div class="inicio-contacto-acciones">
        <a class="accion-cotizar" href="cotizaciones.html" data-i18n="hero.solicitarCotizacion">Solicitar cotización</a>
        <a href="tel:+12019513723"><span data-i18n="inicio.llamar">Llámanos</span> · 201-951-3723</a>
    </div>
</section>
