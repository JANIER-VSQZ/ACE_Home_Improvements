<section class="seleccion-servicios">
    <div class="track">
        {{#each servicioData}}
        <div class="servicio">
            <div class="img-servicio">
                <img src="{{this.imgLink}}" alt="{{this.nombreServicio}}" data-i18n="[alt]cotizacionServicios.{{@index}}.nombreServicio">
            </div>
            <div  class="btn-servicio" data-label="{{this.nombreServicio}}">
                <p data-i18n="cotizacionServicios.{{@index}}.nombreServicio">{{this.nombreServicio}}</p>
            </div>  
            <a class="mas-info" href="servicios.html?SRV={{this.nombreServicio}}" data-i18n="comun.masInformacion">Más información.</a>
        </div>
        {{/each}}
    </div>
</section>
