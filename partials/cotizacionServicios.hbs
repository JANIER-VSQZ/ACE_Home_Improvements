<section class="seleccion-servicios">
    <div class="track">
        {{#each servicioData}}
        <div class="servicio">
            <div class="img-servicio">
                <img src="{{this.imgLink}}" alt="{{this.nombreServicio}}">
            </div>
            <div  class="btn-servicio" data-label="{{this.nombreServicio}}">
                <p data-i18n="cotizacionServicios.{{@index}}.nombreServicio">{{this.nombreServicio}}</p>
            </div>  
            <a class="mas-info" href="servicios.html?SRV={{this.nombreServicio}}">Mas Información.</a> 
        </div>
        {{/each}}
    </div>
</section>