<div class="testimonial-card">
    <div class="testimonial-avatar">
        <img src="{{imagen}}" alt="{{nombre}}" data-i18n="[alt]testimonios.empleados.{{indice}}.nombre">
        <p data-i18n="testimonios.empleados.{{indice}}.nombre">{{nombre}}</p>
    </div>
    <blockquote data-i18n="testimonios.empleados.{{indice}}.testimonio">
        "{{testimonio}}"
    </blockquote>
</div>
