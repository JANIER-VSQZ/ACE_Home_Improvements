<form id="{{id}}" class="form form--{{type}}" action="{{endpoint}}" method="post" data-form-type="{{type}}" data-submit-form novalidate>
  {{> forms/submission-status}}
  <input class="form__honeypot" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true">
  {{#each sections}}
    <fieldset class="form__section">
      {{#if titleKey}}<legend data-i18n="{{titleKey}}">{{t titleKey}}</legend>{{/if}}
      <div class="form__fields">
        {{#each fields}}
          {{> forms/field}}
        {{/each}}
      </div>
    </fieldset>
  {{/each}}
  <button class="button" type="submit" data-i18n="{{submitKey}}" disabled>{{t submitKey}}</button>
  <noscript><p class="form__notice" data-i18n="formularios.sinJavaScript">{{t "formularios.sinJavaScript"}}</p></noscript>
</form>
