<section class="section container">
  {{> components/page-heading}}
  <div class="contact-layout">
    <div class="contact-layout__info">
      <img class="contact-layout__image" src="{{asset "images/casco.jpg"}}" alt="{{t "contacto.imagen"}}" data-i18n="[alt]contacto.imagen" width="640" height="480">
      <h2 data-i18n="contacto.numeros">{{t "contacto.numeros"}}</h2>
      <ul class="contact-list">
        <li><a href="tel:+12019513723">201-951-3723</a></li>
        <li><a href="tel:+19732884024">973-288-4024</a></li>
        <li><a href="tel:+19733377454">973-337-7454</a></li>
      </ul>
      <p data-i18n="inicio.coberturaDescripcion">{{t "inicio.coberturaDescripcion"}}</p>
    </div>
    <div class="form-panel">
      <h2 data-i18n="contacto.titulo">{{t "contacto.titulo"}}</h2>
      <p data-i18n="contacto.descripcion">{{t "contacto.descripcion"}}</p>
      {{> forms/form forms.contact}}
    </div>
  </div>
</section>
