<section class="hero">
  <div class="hero__media carousel" data-carousel>
    {{#each heroImages}}
      <img
        class="carousel__slide {{#if @first}}is-active{{/if}}"
        src="{{asset this}}"
        alt="{{t "hero.imagen"}}"
        data-i18n="[alt]hero.imagen"
        width="1280"
        height="720"
        {{#unless @first}}loading="lazy"{{/unless}}
      >
    {{/each}}
  </div>
  <div class="hero__content container">
    <div class="hero__card">
      <h1><span data-i18n="hero.bienvenido">{{t "hero.bienvenido"}}</span> ACE</h1>
      <p data-i18n="hero.descripcion">{{t "hero.descripcion"}}</p>
      <div class="hero__actions">
        <a class="button button--accent" href="cotizaciones.html" data-i18n="hero.solicitarCotizacion">
          {{t "hero.solicitarCotizacion"}}
        </a>
        <a class="button button--secondary" href="proyectosDestacados.html" data-i18n="hero.verProyectos">
          {{t "hero.verProyectos"}}
        </a>
      </div>
      <p data-i18n="hero.somosLideres">{{t "hero.somosLideres"}}</p>
    </div>
  </div>
</section>

<section class="section container">
  <h2 class="section__title" data-i18n="comun.nuestrosServicios">{{t "comun.nuestrosServicios"}}</h2>
  <div class="service-preview-grid">
    {{#each services}}
      <a class="service-preview" href="{{detailsHref}}">
        <img
          src="{{asset image}}"
          alt="{{titulo}}"
          data-i18n="[alt]{{key}}.titulo"
          width="400"
          height="260"
          loading="lazy"
        >
        <h3 data-i18n="{{key}}.titulo">{{titulo}}</h3>
        <span class="text-link" data-i18n="comun.masInformacion">{{t "comun.masInformacion"}}</span>
      </a>
    {{/each}}
  </div>
</section>

<section class="section section--muted">
  <div class="container">
    <div class="section__heading">
      <div>
        <p class="eyebrow" data-i18n="inicio.portafolio">{{t "inicio.portafolio"}}</p>
        <h2 data-i18n="proyectos.titulo">{{t "proyectos.titulo"}}</h2>
        <p data-i18n="inicio.proyectosDescripcion">{{t "inicio.proyectosDescripcion"}}</p>
      </div>
      <a class="text-link" href="galeria.html" data-i18n="inicio.verGaleria">{{t "inicio.verGaleria"}}</a>
    </div>
    <div class="card-grid">
      {{#each projects}}
        {{> components/project-card preview=true}}
      {{/each}}
    </div>
  </div>
</section>

<section class="section container">
  <p class="eyebrow" data-i18n="inicio.acompanamiento">{{t "inicio.acompanamiento"}}</p>
  <h2 class="section__title" data-i18n="inicio.procesoTitulo">{{t "inicio.procesoTitulo"}}</h2>
  <div class="process-grid">
    <article>
      <span aria-hidden="true">01</span>
      <h3 data-i18n="inicio.proceso.0.titulo">{{t "inicio.proceso.0.titulo"}}</h3>
      <p data-i18n="inicio.proceso.0.descripcion">{{t "inicio.proceso.0.descripcion"}}</p>
    </article>
    <article>
      <span aria-hidden="true">02</span>
      <h3 data-i18n="inicio.proceso.1.titulo">{{t "inicio.proceso.1.titulo"}}</h3>
      <p data-i18n="inicio.proceso.1.descripcion">{{t "inicio.proceso.1.descripcion"}}</p>
    </article>
    <article>
      <span aria-hidden="true">03</span>
      <h3 data-i18n="inicio.proceso.2.titulo">{{t "inicio.proceso.2.titulo"}}</h3>
      <p data-i18n="inicio.proceso.2.descripcion">{{t "inicio.proceso.2.descripcion"}}</p>
    </article>
  </div>
  <a class="text-link" href="acercaNosotros.html" data-i18n="inicio.conocerEquipo">{{t "inicio.conocerEquipo"}}</a>
</section>

<section class="section section--muted">
  <div class="container">
    <h2 class="section__title" data-i18n="testimonios.titulo">{{t "testimonios.titulo"}}</h2>
    <div class="card-grid">
      {{#each featuredTestimonials}}
        {{> components/testimonial-card}}
      {{/each}}
    </div>
    <a class="text-link section__link" href="testimonios.html" data-i18n="inicio.verTestimonios">
      {{t "inicio.verTestimonios"}}
    </a>
  </div>
</section>

<section class="section section--dark">
  <div class="container home-contact">
    <div>
      <p class="eyebrow" data-i18n="inicio.coberturaTitulo">{{t "inicio.coberturaTitulo"}}</p>
      <h2 data-i18n="inicio.contactoTitulo">{{t "inicio.contactoTitulo"}}</h2>
      <p data-i18n="inicio.coberturaDescripcion">{{t "inicio.coberturaDescripcion"}}</p>
    </div>
    <div class="home-contact__actions">
      <a class="button button--accent" href="cotizaciones.html" data-i18n="hero.solicitarCotizacion">
        {{t "hero.solicitarCotizacion"}}
      </a>
      <a href="tel:+12019513723">
        <span data-i18n="inicio.llamar">{{t "inicio.llamar"}}</span> · 201-951-3723
      </a>
    </div>
  </div>
</section>
