<article class="service-card" data-service-name="{{name}}" tabindex="-1">
  <img src="{{asset image}}" alt="{{titulo}}" data-i18n="[alt]{{key}}.titulo" width="640" height="420" loading="lazy">
  <div class="service-card__body">
    <h2 data-i18n="{{key}}.titulo">{{titulo}}</h2>
    <p data-i18n="{{key}}.descripcion">{{descripcion}}</p>
    <a class="button" href="{{quoteHref}}" data-i18n="{{key}}.boton">{{t (concat key ".boton")}}</a>
  </div>
</article>
